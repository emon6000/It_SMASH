# ---- Server ----
PORT=5000
# Frontend address(es) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msmart

# ---- Admin (single account) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Any long random string
JWT_SECRET=change-this-to-a-long-random-string

# ---- Shown on the website (used by frontend in Phase 2) ----
SITE_NAME=It SMASH
WHATSAPP_NUMBER=8801700000000
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61595713630252
CONTACT_PHONE=01700-000000
BKASH_NUMBER=01700-000000

# ---- Cloudinary image storage (optional but recommended for production) ----
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=it-smash/products
